{
  "name": "ant-design-pro",
  "version": "6.0.2",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "repository": "git@github.com:ant-design/ant-design-pro.git",
  "scripts": {
    "analyze": "cross-env DID_YOU_KNOW=none ANALYZE=1 max build",
    "build": "cross-env DID_YOU_KNOW=none max build",
    "deploy": "cross-env CI=true DID_YOU_KNOW=none max build && gh-pages -d dist",
    "dev": "cross-env DID_YOU_KNOW=none UMI_ENV=dev MOCK=none HOST=localhost PORT=8002 max dev",
    "lint": "npm run biome:lint && npm run tsc",
    "lint-staged": "lint-staged",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "openapi": "max openapi",
    "prepare": "npx husky && max setup",
    "preview": "max preview --port 8002",
    "preview:build": "max build && max preview --port 8002",
    "record": "cross-env NODE_ENV=development UMI_ENV=test max record --scene=login",
    "start": "node scripts/start.js",
    "start:no-mock": "cross-env DID_YOU_KNOW=none MOCK=none max dev",
    "start:pre": "cross-env DID_YOU_KNOW=none UMI_ENV=pre MOCK=none max dev",
    "start:test": "cross-env DID_YOU_KNOW=none UMI_ENV=test MOCK=none max dev",
    "test": "cross-env DID_YOU_KNOW=none jest",
    "test:coverage": "cross-env DID_YOU_KNOW=none jest --coverage",
    "test:update": "cross-env DID_YOU_KNOW=none jest -u",
    "doctor": "react-doctor .",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@ant-design/pro-components": "^3.1.12-0",
    "@tanstack/react-query": "^5.100.6",
    "antd": "^6.4.3",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swagger-ui-dist": "^5.32.6"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.4.3",
    "@biomejs/biome": "^2.4.13",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@umijs/lint": "^4.6.51",
    "@umijs/max": "^4.6.51",
    "@umijs/max-plugin-openapi": "^2.0.3",
    "@umijs/request-record": "^1.1.4",
    "@utoo/pack": "^1.4.9",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.2",
    "react-doctor": "^0.2.1",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "create-umi": {
    "ignoreScript": [
      "docker*",
      "functions*",
      "site",
      "generateMock"
    ],
    "ignoreDependencies": [
      "netlify*",
      "serverless"
    ],
    "ignore": [
      ".dockerignore",
      ".git",
      ".github",
      ".gitpod.yml",
      "CODE_OF_CONDUCT.md",
      "Dockerfile",
      "Dockerfile.*",
      "lambda",
      "LICENSE",
      "netlify.toml",
      "README.*.md",
      "azure-pipelines.yml",
      "docker",
      "CNAME",
      "create-umi"
    ]
  }
}
